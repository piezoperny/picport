{{- /* Generate a JSON list of geotagged images (marked by "--") with thumbnails, date/time, and EXIF */ -}}
{{- $items := slice -}}
{{- with .Site.GetPage "section" "gallery" -}}
    {{- range .Sections -}}
        {{- $collectionTitle := .Title | lower -}}
        {{- $collectionUrl := .RelPermalink -}}
        {{- range sort (.Resources.ByType "image") "Name" "desc" -}}
            {{- if in .Name "--" -}}
                {{- $thumb := .Resize "400x webp q85" -}}
                {{- $lightbox := .Resize "1600x webp q90" -}}
                {{- $dateStr := replaceRE "^(\\d{4})(\\d{2})(\\d{2}).*" "$1-$2-$3" .Name -}}
                {{- if eq $dateStr .Name -}}{{- $dateStr = "" -}}{{- end -}}
                {{- $timeStr := replaceRE "^\\d{8}_(\\d{2})(\\d{2}).*" "$1:$2" .Name -}}
                {{- if eq $timeStr .Name -}}{{- $timeStr = "" -}}{{- end -}}
                {{- $camera := "" -}}
                {{- $iso := "" -}}
                {{- $aperture := "" -}}
                {{- $shutter := "" -}}
                {{- $exifStr := "" -}}
                {{- $base := index (split .Name "--") 0 -}}
                {{- if gt (len $base) 16 -}}
                    {{- $techRaw := substr $base 16 -}}
                    {{- $parts := split $techRaw "_" -}}
                    {{- if ge (len $parts) 4 -}}
                        {{- $shutterRaw := index $parts (sub (len $parts) 1) -}}
                        {{- $shutter = printf "%s s" (replaceRE "^1-" "1/" $shutterRaw) | lower -}}
                        {{- $aperture = printf "f/%s" (index $parts (sub (len $parts) 2)) | lower -}}
                        {{- $iso = printf "iso %s" (index $parts (sub (len $parts) 3)) | lower -}}
                        {{- $camParts := first (sub (len $parts) 3) $parts -}}
                        {{- $camera = delimit $camParts " " | lower -}}
                        {{- $exifStr = printf "📷 %s • %s • %s • %s" $camera $iso $aperture $shutter -}}
                    {{- end -}}
                {{- end -}}
                {{- $items = $items | append (dict
                    "url" $lightbox.RelPermalink
                    "lightbox" $lightbox.RelPermalink
                    "thumb" $thumb.RelPermalink
                    "name" .Name
                    "collection" $collectionTitle
                    "collectionUrl" $collectionUrl
                    "date" $dateStr
                    "time" $timeStr
                    "exif" $exifStr
                    "camera" $camera
                    "iso" $iso
                    "aperture" $aperture
                    "shutter" $shutter
                ) -}}
            {{- end -}}
        {{- end -}}
    {{- end -}}
{{- end -}}
{{- $items | jsonify -}}
